generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Application {
  id        String   @id @default(cuid())
  fullName  String
  telegram  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("applications")
}
